#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/layer.h>
#include "keys_fr_canadian_standard.h"

/include/ {
    #include <behaviors.dtsi>
};

/keymap/ {
    compatible = "zmk,keymap";

    layers {
        default_layer {
            row1 = <
                &th MOD_LSFT &kp ESC       &m N1          &m N2          &m N3          &m N4          &m N5
                &th MOD_LSFT &kp N6        &m N7          &m N8          &m N9          &m N0          &m MINUS
            >;
            row2 = <
                &m TAB         &m Q         &m W         &m E         &m R         &m T
                &m Y         &m U         &m I         &m O         &m P         &th MOD_LSFT &m EQUAL
            >;
            row3 = <
                &m LSFT        &m A         &m S         &m D         &m F         &m G
                &m H         &m J         &m K         &m L         &m SEMICOLON &th MOD_LSFT &m QUOTE
            >;
            row4 = <
                &m LCTRL       &m Z         &m X         &m C         &m V         &m B
                &th MOD_LSFT &m LBKT      &th MOD_LSFT &m RBKT      &m N         &m M         &th MOD_LSFT &m COMMA     &th MOD_LSFT &m DOT       &th MOD_LSFT &m SLASH
            >;
            row5 = <
                            &m LGUI        &m LALT        &m LSFT        &m SPACE
                            &lt 1 &m ENTER &th MOD_LSFT &m BACKSPACE &mo 2        &m BACKSLASH
            >;
        };

        raise_layer {
            row1 = <
                &m TILDE       &m F1        &m F2        &m F3        &m F4        &m F5
                &m F6        &m F7        &m F8        &m F9        &m F10       &m F11
            >;
            row2 = <
                &m PIPE        &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans
            >;
            row3 = <
                &trans       &trans       &trans       &m HOME      &m END       &trans
                &m LEFT      &m DOWN      &m UP        &m RIGHT     &trans       &m GRAVE
            >;
            row4 = <
                &trans       &trans       &trans       &trans       &trans       &trans
                &m LPAR      &m RPAR      &m PLUS      &m MINUS     &m EQUAL     &m LBKT      &m BACKSLASH     &trans
            >;
            row5 = <
                            &trans       &trans       &trans       &m SLASH
                            &none        &m DELETE    &to 3        &m PRINTSCREEN
            >;
        };

        meta_layer {
            row1 = <
                &out OUT_USB &m BT_CONNECT 0    &m BT_CONNECT 1    &m BT_CONNECT 2    &m BT_CONNECT 3    &m BT_CONNECT 4
                &trans       &trans       &trans       &trans       &m BT_CLR      &trans
            >;
            row2 = <
                &m F1        &m F2        &m F3        &m F4        &m F5        &m F6
                &m F7        &m F8        &m F9        &m F10       &m F11       &m F12
            >;
            row3 = <
                &m GRAVE     &m EXCLAM    &m AT        &m HASH      &m DOLLAR    &m PERCENT
                &m CARET     &m AMPERSAND &m ASTERISK  &m LPAR      &m RPAR      &m TILDE
            >;
            row4 = <
                &trans       &m POWER_ON  &m POWER_OFF &m POWER_TOG &trans       &trans
                &m LPAR      &m RPAR      &trans       &m MINUS     &m PLUS      &m LBRC      &m RBRC      &m PIPE
            >;
            row5 = <
                            &m BOOTLOADER &trans       &trans       &trans
                &trans       &trans       &trans       &trans
            >;
        };

        no_combo_layer {
            row1 = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            row2 = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            row3 = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            row4 = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            row5 = <
                &trans &trans &trans &trans
                &trans &trans &to 0 &trans
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        eacute_combo: eacute_combo {
            bindings = <&m E_ACUTE>;
            key-positions = <15 16>;
            layers = <0>;
        };

        egrave_combo: egrave_combo {
            bindings = <&m E_GRAVE>;
            key-positions = <15 14>;
            layers = <0>;
        };

        agrave_combo: agrave_combo {
            bindings = <&m A_GRAVE>;
            key-positions = <25 26>;
            layers = <0>;
        };

        ccedila_combo: ccedila_combo {
            bindings = <&m C_CEDILLA>;
            key-positions = <38 39>;
            layers = <0>;
        };

        ugrave_combo: ugrave_combo {
            bindings = <&m U_GRAVE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        end_combo: end_combo {
            bindings = <&macro_o_circ>;
            key-positions = <22 21 20>;
            layers = <0>;
        };

        ecirc_combo: ecirc_combo {
            bindings = <&macro_e_circ>;
            key-positions = <15 14 16>;
            layers = <0>;
        };

        acirc_combo: acirc_combo {
            bindings = <&macro_a_circ>;
            key-positions = <25 26 24>;
            layers = <0>;
        };

        ocirc_combo: ocirc_combo {
            bindings = <&macro_o_circ>;
            key-positions = <22 20 21>;
            layers = <0>;
        };

        icirc_combo: icirc_combo {
            bindings = <&macro_i_circ>;
            key-positions = <19 20 21>;
            layers = <0>;
        };

        ucirc_combo: ucirc_combo {
            bindings = <&macro_u_circ>;
            key-positions = <18 19 20>;
            layers = <0>;
        };
    };

    macros {
        macro_o_circ: macro_o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m CARET &m O>;
        };

        macro_e_circ: macro_e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m CARET &m E>;
        };

        macro_tilde: macro_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m TILDE &m SPACE>;
        };

        macro_backtick: macro_backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m GRAVE &m SPACE>;
        };

        macro_a_circ: macro_a_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m CARET &m A>;
        };

        macro_i_circ: macro_i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m CARET &m I>;
        };

        macro_u_circ: macro_u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&m CARET &m U>;
        };
    };
};
